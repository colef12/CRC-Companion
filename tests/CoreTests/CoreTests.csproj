<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dependency-free test runner for the platform-neutral Core code. Run with: dotnet run, project tests/CoreTests -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\CrcCompanion\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\CrcCompanion\Ui\EramFont*.cs" Link="Ui\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\CrcCompanion\Ui\ToolbarLabels*.cs" Link="Ui\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
