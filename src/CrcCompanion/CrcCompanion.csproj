<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>CRCCompanion</AssemblyName>
    <RootNamespace>CrcCompanion</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>CrcCompanion.Program</StartupObject>
    <Version>0.1.0</Version>
    <Product>CRC Companion</Product>
    <Description>External, movable ERAM views for VATSIM CRC</Description>
  </PropertyGroup>
</Project>
